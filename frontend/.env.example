# Preserve the approved attendee/exhibitor demo by default.
# Set live explicitly to test the backend integration preview.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/api
# Vite proxy; Docker compose supplies http://backend:8000 instead.
BACKEND_PROXY_TARGET=http://127.0.0.1:8001
VITE_VISUALIZATION_URL=http://127.0.0.1:5174/
